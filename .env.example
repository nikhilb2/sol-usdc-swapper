# sol-usdc-swapper — Environment Config
# Copy this to .env and fill in your values

# Your Solana wallet private key (base58 string OR JSON array format)
PRIVATE_KEY=your_private_key_here

# Helius or other RPC endpoint
RPC_URL=https://your-rpc-endpoint

# Optional: Jupiter API key (higher rate limits)
# JUPITER_API_KEY=

# ── Storage ──────────────────────────────────────────────────────────────────
# Set DATABASE_URL to use Postgres; leave it unset to use JSONL files.
#
# `docker compose up -d` starts a local Postgres using the POSTGRES_* values
# below. Port 5436 rather than 5432, which is commonly already taken.
#
# IMPORTANT: percent-encode the password in DATABASE_URL. A literal # both
# truncates the URL at the fragment AND is read as a start-of-comment by
# dotenv. Encode it as %23. Node one-liner to build the URL safely:
#   node -e 'console.log(`postgresql://${encodeURIComponent("USER")}:${encodeURIComponent("PASS")}@127.0.0.1:5436/${encodeURIComponent("DB")}`)'
#
# POSTGRES_USER=swapper
# POSTGRES_PASSWORD="quote-me-if-I-contain-#-or-spaces"
# POSTGRES_DB=sol-swapper
# POSTGRES_PORT=5436
# DATABASE_URL=postgresql://swapper:swapper@127.0.0.1:5436/sol-swapper

# Force a backend regardless of DATABASE_URL: "files" or "postgres".
# The test suite sets this to "files" so a stray DATABASE_URL can never
# point tests at a real database.
# STORAGE_BACKEND=

# Where the file backend writes (default: ./data). Ignored on Postgres.
# DATA_DIR=./data

# Set to true to quote + log a swap without submitting it on-chain
# DRY_RUN=false

# ── Accumulation strategy ────────────────────────────────────────────────────

# Master switch. Set to "false" to make `node run.js` a no-op.
# STRATEGY_ENABLED=true

# What to accumulate. One of: JUPSOL, JITOSOL, MSOL, SOL
# Liquid staking tokens grow against SOL as rewards accrue, which is the only
# reliable way this stack gets bigger in SOL terms. Realized 12-month yield
# measured 2026-08-28: jupSOL 6.30% | mSOL 6.19% | jitoSOL 5.80%
# STRATEGY_ASSET=JUPSOL

# Daily budget in USD. Accrues every day whether or not a buy happens.
# STRATEGY_DAILY_USD=13

# "daily" or "weekly". Weekly makes 7x fewer taxable events for ~the same result.
# STRATEGY_CADENCE=daily

# Max unspent budget carried forward before it is deployed regardless.
# Keep this tight — idle cash is an unintentional bet against the market.
# STRATEGY_MAX_CARRY_USD=36

# Dip boost: when total P&L is negative, buy bigger. The next buy is scaled by
#   1 + (drawdown fraction * STRATEGY_BOOST_FACTOR), capped at STRATEGY_MAX_BOOST
# At the defaults: down 2% -> 1.20x, down 5% -> 1.50x, and nothing beyond that.
# At or above break-even the multiplier is exactly 1.
#
# This is averaging down, not a timing edge — the backtest found none and this
# rule does not create one. It lowers the average cost of the units it buys and
# raises total exposure.
#
# It also spends money the daily budget never accrued (carry floors at 0), so
# lifetime spentUsd drifts above accruedUsd. The wallet's USDC balance is the
# real limit: keep it funded above the plain STRATEGY_DAILY_USD rate, or the
# boosted buys are just clamped to whatever balance is there.
#
# Set to "false" to disable.
# STRATEGY_BOOST_ON_LOSS=true

# Multiplier applied to the drawdown fraction. 10 = "10x the percentage".
# STRATEGY_BOOST_FACTOR=10

# Hard ceiling on the multiplier. Without it a 50% drawdown asks for a 6x buy at
# exactly the moment the wallet can least afford it. 1.5 caps out at a 5%
# drawdown, so a dip is leaned into but never sets the size of the trade.
# STRATEGY_MAX_BOOST=1.5

# Units of STRATEGY_ASSET this wallet already held before the bot started, or
# otherwise acquired outside it. The bot cannot know this — it never saw the
# trade — so you declare it here.
#
# Declaring it only changes the LABEL on the reconciliation line: "declared
# opening balance" instead of "unexplained". These units never enter the P&L
# or the benchmark either way, because the bot has no cost basis for them.
# Find the number to put here by running `node report.js` and reading the
# "unexplained" line, once you have confirmed it is really yours.
# STRATEGY_OPENING_UNITS=0

# Optional CoinGecko Demo key. Only used as a price-history fallback; the
# keyless tier rate-limits hard (429 on the second call).
# COINGECKO_API_KEY=

# ── Dashboard ────────────────────────────────────────────────────────────────
# Read-only monitoring UI:  npm run dashboard
# The server refuses to start unless both are set and the password is >= 12
# chars — a monitoring page that silently comes up unauthenticated is worse
# than one that does not come up at all.
#
# Generate a password:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=
# DASHBOARD_PORT=8787
# Loopback only. Change this ONLY behind TLS — Basic auth is base64, not encryption.
# DASHBOARD_HOST=127.0.0.1

# ── Kubernetes ───────────────────────────────────────────────────────────────
# The in-cluster database, shipped by k8s/make-secret.sh. DATABASE_URL above
# stays pointed at local Docker; pods cannot reach your loopback.
# K8S_DATABASE_URL=postgresql://solswapper:<pw>@postgres.db.svc.cluster.local:5432/sol-swapper

# ── Custody transfer ─────────────────────────────────────────────────────────
# Sweep the accumulated LST to a safer wallet. The destination is PINNED here
# and can never be supplied by an HTTP request — an attacker holding the
# dashboard password can at worst force the coins into your own safe wallet.
#
# This address must be a plain wallet. A token account or PDA derives an
# associated token account that no key can ever sign for, and the funds are
# gone permanently. config.js checks base58 canonicality, the ed25519 curve and
# the mint list; transfer.js additionally checks the chain says System Program
# owns it. Being on-curve is NOT sufficient on its own — mint addresses are
# ordinary ed25519 keys and pass that check.
# TRANSFER_DESTINATION=

# Both default false. `enabled` gates the CLI, `httpEnabled` gates the button.
# TRANSFER_ENABLED=false
# TRANSFER_HTTP_ENABLED=false

# Rate limits, enforced against the trade log so they survive a pod restart.
# TRANSFER_COOLDOWN_MINUTES=60
# TRANSFER_MAX_PER_DAY=2
# TRANSFER_PRIORITY_FEE=20000

# Exact origin the browser sends, for the CSRF Origin check. Empty is fine on
# loopback; set it once the dashboard is behind a real hostname.
# DASHBOARD_PUBLIC_ORIGIN=https://sol.example.com

# ── Price alerts ─────────────────────────────────────────────────────────────
# `npm run watch` checks every active alert and sends the ones that trigger to
# Telegram. In the cluster they come from the `sol-swapper-telegram` Secret, so
# these are for running locally only.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Check interval, re-arm band for repeating alerts, and their minimum gap.
# ALERTS_INTERVAL_SECONDS=60
# ALERTS_REARM_PCT=1
# ALERTS_REPEAT_COOLDOWN_MINUTES=60
